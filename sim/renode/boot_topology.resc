# boot_topology.resc -- boot K1 + K3 on one shared CAN bus, then auto-start.
# Run from a Renode monitor:
#   i @D:/zephyr-ws/Zephyr-Renode-S32K-sim/sim/renode/boot_topology.resc

# Shared virtual CAN bus
emulation CreateCANHub "canbus0"

# ---- K3 zonal hub (the listener) ----
mach create "k3_hub"
machine LoadPlatformDescription @D:/zephyr-ws/Zephyr-Renode-S32K-sim/sim/renode/k3_hub_s32k388.repl
sysbus LoadELF @D:/zephyr-ws/Zephyr-Renode-S32K-sim/build/k3_hub/zephyr/zephyr.elf
cpu0 VectorTableOffset `sysbus GetSymbolAddress "_vector_table"`
connector Connect sysbus.can0 canbus0
showAnalyzer sysbus.lpuart2

# ---- K1 powertrain, node 1 (the sender) ----
mach create "k1_powertrain"
machine LoadPlatformDescription @D:/zephyr-ws/Zephyr-Renode-S32K-sim/sim/renode/k1_edge.repl
sysbus LoadELF @D:/zephyr-ws/Zephyr-Renode-S32K-sim/build/k1_powertrain/zephyr/zephyr.elf
cpu0 VectorTableOffset `sysbus GetSymbolAddress "_vector_table"`
connector Connect sysbus.can0 canbus0
showAnalyzer sysbus.lpuart2

start