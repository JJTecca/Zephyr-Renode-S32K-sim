/* ADR-017: enable lpuart1 as the inter-node telemetry bus (Renode UART hub
 * stands in for CAN FD in simulation). lpuart2 stays the console. */
&lpuart1 {
	pinctrl-0 = <&lpuart1_default>;
	pinctrl-names = "default";
	clocks = <&clock NXP_S32_LPUART1_CLK>;
	current-speed = <115200>;
	status = "okay";
};