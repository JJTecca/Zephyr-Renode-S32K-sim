/* Overwrite needed */
#include <nxp/s32/S32K344-172MQFP-pinctrl.h>

/* ADR-017: lpuart1 = inter-node telemetry link (Renode UART hub stands in for
 * CAN FD). Console stays lpuart2 (board default) so the topology analyzer shows it. */
&lpuart1 {
	pinctrl-0 = <&lpuart1_default>;
	pinctrl-names = "default";
	clocks = <&clock NXP_S32_LPUART1_CLK>;
	current-speed = <115200>;
	status = "okay";
};